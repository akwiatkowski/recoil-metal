+		Copy(w.sunDir, ISky::GetSky()->GetLight()->GetLightDir()); w.sunDir[3] = 0.0f;
+		w.mapMid[0] = mapDims.mapx * SQUARE_SIZE * 0.5f; w.mapMid[1] = 0.0f; w.mapMid[2] = mapDims.mapy * SQUARE_SIZE * 0.5f;
