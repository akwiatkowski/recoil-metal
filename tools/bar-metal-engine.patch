+CONFIG(bool, NativeMetalWorld).defaultValue(true)
+	.description("Render normal SMF terrain and default opaque S3O units directly with Metal on macOS SDL3/EGL. Serializes GL and Metal queues for correctness.");
+
+namespace {
+// The ABI borrows storage, not copies or private framebuffer attachments. Its
+// frame export rejects non-window orientation, texture views, MRT and MSAA.
+struct MesaABI {
+	using Frame = int (*)(void**, void**);
+	using Texture = void* (*)(unsigned int);
+	void* library = nullptr;
+	Frame frame = nullptr;
+	Texture texture = nullptr;
+
+	MesaABI() {
+		library = dlopen("libgallium-26.1.0-devel.dylib", RTLD_NOW | RTLD_LOCAL);
+		if (library == nullptr)
+			throw content_error(std::string("NativeMetalWorld cannot load Gallium: ") + dlerror());
+		frame = reinterpret_cast<Frame>(dlsym(library, "recoil_metal_frame"));
+		texture = reinterpret_cast<Texture>(dlsym(library, "recoil_metal_texture"));
+		if (frame == nullptr || texture == nullptr) {
+			dlclose(library);
+			library = nullptr;
+			throw content_error("NativeMetalWorld requires the Gallium native Metal attachment/texture ABI");
+		}
+	}
+	~MesaABI() { if (library != nullptr) dlclose(library); }
+};
+
+struct alignas(16) Scene {
+	float viewProjection[16];
+	float eye[4];
+	float sun[4];
+	float ambient[4];
+	float diffuse[4];
+	float specular[4];
+	float fogColor[4];
+	float fog[4]; // start, end, GL zero-to-one, alpha discard threshold
+	float shadowMatrix[16];
+	float shadow[4]; // density, depth bias, enabled, reserved
+};
+struct alignas(16) WaterU {
+	float surfaceColor[4];
+	float diffuseColor[4];
+	float specularColor[4];
+	float paramsA[4];
+	float paramsB[4];
+	float paramsC[4];
+	float paramsD[4];
+	float paramsE[4];
+	float eyePos[4];
+	float sunDir[4];
+	float mapMid[4];
+	float texGenPlane[4];
+	float shadingPlane[4];
+	float screen[4];
+	float viewPos[4];
+	float fog[4];
+	float shadowMatrix[16];
+};
+static_assert(sizeof(WaterU) == 16 * 16 + 64);
+struct alignas(16) Draw {
+	float world[16];
+	float team[4];
+	float tile[4]; // heightmap origin, square count, reserved
+};
+struct Vertex {
+	float position[3];
+	float normal[3];
+	float uv[2];
+};
+static_assert(sizeof(Vertex) == 32);
+static_assert(sizeof(Scene) == 256);
+static_assert(sizeof(Draw) == 96);
+// Dynamic per-draw uniforms use one persistent shared buffer, with aligned
+// offsets. Immutable indices/model geometry are uploaded only on first use.
+constexpr size_t DRAW_STRIDE = 256;
+constexpr unsigned TILE_SIZE = CSMFReadMap::bigSquareSize;
+
+constexpr const char* metalSource = R"MSL(#include <metal_stdlib>
+using namespace metal;
+struct Scene {
+    float4x4 viewProjection;
+    float4 eye, sun, ambient, diffuse, specular, fogColor, fog;
+    float4x4 shadowMatrix;
+    float4 shadow; // density, bias, enabled, reserved
+};
+struct Draw { float4x4 world; float4 team, tile; };
+struct Vertex { packed_float3 position, normal; packed_float2 uv; };
+struct Raster {
+    float4 position [[position]];
+    float3 world, normal;
+    float2 uv;
+};
+float4 clipPosition(float3 world, constant Scene& s) {
+    float4 p = s.viewProjection * float4(world, 1.0);
+    // Gallium's ABI guarantees a FlipY window attachment. Camera matrices
+    // already include GL_ZERO_TO_ONE when clip-control is supported.
+    p.y = -p.y;
+    if (s.fog.z == 0.0) p.z = (p.z + p.w) * 0.5;
+    return p;
+}
+vertex Raster terrainVertex(uint index [[vertex_id]],
+                            constant Scene& s [[buffer(1)]],
+                            constant Draw& d [[buffer(2)]],
+                            texture2d<float, access::read> heights [[texture(0)]]) {
+    uint side = uint(d.tile.z) + 1;
+    uint2 local = uint2(index % side, index / side);
+    uint2 q = uint2(d.tile.xy) + local;
+    uint2 last = uint2(heights.get_width() - 1, heights.get_height() - 1);
+    uint2 lo = uint2(q.x > 0 ? q.x - 1 : 0, q.y > 0 ? q.y - 1 : 0);
+    uint2 hi = min(q + 1, last);
+    float hx = heights.read(uint2(hi.x, q.y)).r - heights.read(uint2(lo.x, q.y)).r;
+    float hz = heights.read(uint2(q.x, hi.y)).r - heights.read(uint2(q.x, lo.y)).r;
+    float3 tx = float3(float(hi.x - lo.x) * 8.0, hx, 0.0);
+    float3 tz = float3(0.0, hz, float(hi.y - lo.y) * 8.0);
+    Raster r;
+    r.world = float3(float(q.x) * 8.0, heights.read(q).r, float(q.y) * 8.0);
+    r.normal = normalize(cross(tz, tx));
+    r.position = clipPosition(r.world, s);
+    r.uv = float2(local) / float(d.tile.z);
+    return r;
+}
+vertex Raster unitVertex(uint index [[vertex_id]],
+                         const device Vertex* vertices [[buffer(0)]],
+                         constant Scene& s [[buffer(1)]],
+                         constant Draw& d [[buffer(2)]]) {
+    Vertex v = vertices[index];
+    Raster r;
+    r.world = (d.world * float4(float3(v.position), 1.0)).xyz;
+    // Unit/piece transforms have rotation plus uniform scale, so normalize
+    // handles their scale and the engine's object-space mirroring.
+    r.normal = normalize((d.world * float4(float3(v.normal), 0.0)).xyz);
+    r.position = clipPosition(r.world, s);
+    r.uv = float2(v.uv);
+    return r;
+}
+float shadowed(float3 world, constant Scene& s,
+                   depth2d<float> shadowTex, sampler shadowSampler) {
+    if (s.shadow.z < 0.5) return 1.0;
+    float4 sc = s.shadowMatrix * float4(world, 1.0);
+    float3 coord = sc.xyz / max(sc.w, 0.0001);
+    // Outside the shadow map: lit (matches compat border clamp to white).
+    if (coord.x < 0.0 || coord.x > 1.0 || coord.y < 0.0 || coord.y > 1.0 || coord.z > 1.0)
+        return 1.0;
+    float lit = shadowTex.sample_compare(shadowSampler, coord.xy, coord.z - s.shadow.y);
+    return mix(1.0, lit, s.shadow.x);
+}
+float3 fogged(float3 rgb, float3 world, constant Scene& s) {
+    float distance = length(world - s.eye.xyz);
+    float f = clamp((s.fog.y - distance) / max(s.fog.y - s.fog.x, 0.0001), 0.0, 1.0);
+    return mix(s.fogColor.rgb, rgb, f);
+}
+fragment float4 terrainFragment(Raster r [[stage_in]],
+                               constant Scene& s [[buffer(1)]],
+                               texture2d<float> tile [[texture(0)]],
+                               depth2d<float> shadowTex [[texture(3)]],
+                               sampler filtering [[sampler(0)]],
+                               sampler shadowSampler [[sampler(3)]]) {
+    float4 texel = tile.sample(filtering, r.uv);
+    if (s.fog.w >= 0.0 && texel.a <= s.fog.w) discard_fragment();
+    float light = max(dot(normalize(r.normal), normalize(s.sun.xyz)), 0.0);
+    float shade = shadowed(r.world, s, shadowTex, shadowSampler);
+    return float4(fogged(texel.rgb * (s.ambient.rgb + s.diffuse.rgb * light * shade), r.world, s), 1.0);
+}
+float clipAlpha(float3 world, constant Scene& s) {
+    // Compat GL_CLIP_PLANE3 model-space water clipping: below keeps y<=0,
+    // above keeps y>=0. Encoded in s.shadow.w to avoid growing Scene.
+    if (s.shadow.w < 0.5) return 1.0;
+    bool below = s.shadow.w < 1.5;
+    if (below ? (world.y > 0.0) : (world.y < 0.0)) discard_fragment();
+    return 1.0;
+}
+fragment float4 unitFragment(Raster r [[stage_in]],
+                            constant Scene& s [[buffer(1)]],
+                            constant Draw& d [[buffer(2)]],
+                            texture2d<float> tex1 [[texture(0)]],
+                            texture2d<float> tex2 [[texture(1)]],
+                            depth2d<float> shadowTex [[texture(3)]],
+                            sampler filtering [[sampler(0)]],
+                            sampler shadowSampler [[sampler(3)]]) {
+    float4 base = tex1.sample(filtering, r.uv);
+    float4 extra = tex2.sample(filtering, r.uv);
+    if (extra.a < 0.5) discard_fragment();
+    float3 n = normalize(r.normal);
+    float3 l = normalize(s.sun.xyz);
+    float3 v = normalize(s.eye.xyz - r.world);
+    float diffuse = max(dot(n, l), 0.0);
+    float h = max(dot(n, normalize(l + v)), 0.0);
+    float specular = min(pow(h, 2.5 * s.specular.w) + 0.3 * pow(h, 6.0), 1.0) * extra.g * 4.0;
+    float3 rgb = mix(base.rgb, d.team.rgb, base.a);
+    float shade = shadowed(r.world, s, shadowTex, shadowSampler);
+    rgb = rgb * (s.ambient.rgb + s.diffuse.rgb * diffuse * shade + extra.rrr) + s.specular.rgb * specular * shade;
+    return float4(fogged(rgb, r.world, s), 1.0);
+}
+fragment float4 unitAlphaFragment(Raster r [[stage_in]],
+                            constant Scene& s [[buffer(1)]],
+                            constant Draw& d [[buffer(2)]],
+                            texture2d<float> tex1 [[texture(0)]],
+                            texture2d<float> tex2 [[texture(1)]],
+                            depth2d<float> shadowTex [[texture(3)]],
+                            sampler filtering [[sampler(0)]],
+                            sampler shadowSampler [[sampler(3)]]) {
+    clipAlpha(r.world, s);
+    float4 base = tex1.sample(filtering, r.uv);
+    float4 extra = tex2.sample(filtering, r.uv);
+    if (extra.a < 0.5) discard_fragment();
+    float3 n = normalize(r.normal);
+    float3 l = normalize(s.sun.xyz);
+    float3 v = normalize(s.eye.xyz - r.world);
+    float diffuse = max(dot(n, l), 0.0);
+    float h = max(dot(n, normalize(l + v)), 0.0);
+    float specular = min(pow(h, 2.5 * s.specular.w) + 0.3 * pow(h, 6.0), 1.0) * extra.g * 4.0;
+    float3 rgb = mix(base.rgb, d.team.rgb, base.a);
+    float shade = shadowed(r.world, s, shadowTex, shadowSampler);
+    rgb = rgb * (s.ambient.rgb + s.diffuse.rgb * diffuse * shade + extra.rrr) + s.specular.rgb * specular * shade;
+    // Compat alpha pass modulates team-color opacity (alphaValues); the base
+    // texture alpha already selected team vs diffuse above.
+    return float4(fogged(rgb, r.world, s), d.team.a);
+}
+// ---- BumpWater surface port (GLSL/BumpWaterVS.glsl + BumpWaterFS.glsl) ----
+// opt_* defines are injected per live flags; all numeric params are uniforms.
+struct WaterU {
+    float4 surfaceColor;   // rgb + alpha
+    float4 diffuseColor;   // rgb + diffuseFactor*15
+    float4 specularColor;  // rgb + specularPower
+    float4 paramsA;        // ambientFactor, specularFactor, fresnelMin, fresnelMax
+    float4 paramsB;        // fresnelPower, reflDistortion, blurBase, blurExponent
+    float4 paramsC;        // perlinStartFreq, perlinLacunarity, perlinAmp, waveOffsetFactor
+    float4 paramsD;        // waveLength, waveFoamDistortion, waveFoamIntensity, causticsResolution
+    float4 paramsE;        // causticsStrength, shadowDensity, frame, blurReflectionOn
+    float4 eyePos;
+    float4 sunDir;
+    float4 mapMid;
+    float4 texGenPlane;    // 1/mapX, 1/mapZ, scaleX/mapX, scaleZ/mapZ
+    float4 shadingPlane;   // shadingX/mapX, shadingZ/mapZ, shadingX, shadingZ
+    float4 screen;         // screenInvX, screenInvY, texSizeInvX, texSizeInvY
+    float4 viewPos;        // viewPosX, viewPosY, projM14, projM10
+    float4 fog;            // fogColor rgb + fogEnd, fogScale
+    float4x4 shadowMatrix;
+};
+struct WaterPos { packed_float3 pos; };
+struct WaterRaster {
+    float4 position [[position]];
+    float3 eyeVec, ligVec, worldPos;
+    float4 tc0, tc1, tc2, tc3, tc4, tc5;
+    float fogZ;
+};
+vertex WaterRaster waterVert(uint vid [[vertex_id]],
+                              const device WaterPos* verts [[buffer(0)]],
+                              constant Scene& s [[buffer(1)]],
+                              constant WaterU& w [[buffer(3)]]) {
+    float3 pos = float3(verts[vid].pos);
+    float4 pos4 = float4(pos, 1.0);
+    float4 tc0 = float4(w.texGenPlane.x * pos4.x, w.texGenPlane.y * pos4.z,
+                        w.texGenPlane.z * pos4.x, w.texGenPlane.w * pos4.z);
+    WaterRaster r;
+    r.tc0 = tc0;
+    r.tc5 = float4(0.0); r.tc5.xy = float2(w.shadingPlane.x * pos4.x, w.shadingPlane.y * pos4.z);
+    float fstart = w.paramsC.x;
+    float f = w.paramsC.y;
+    r.tc1.xy = (float2(-1.0,-1.0) + tc0.zw + 0.75) * fstart       + w.paramsE.z * float2(15.0, 15.0);
+    r.tc1.zw = (float2(-1.0, 1.0) + tc0.zw + 0.50) * fstart*f     - w.paramsE.z * float2(15.0, 15.0);
+    r.tc2.xy = (float2( 1.0,-1.0) + tc0.zw + 0.25) * fstart*f*f   + w.paramsE.z * float2(15.0, 15.0);
+    r.tc2.zw = (float2( 1.0, 1.0) + tc0.zw + 0.00) * fstart*f*f*f - w.paramsE.z * float2(15.0, 15.0);
+    r.tc3.xy = tc0.zw * 160.0 + w.paramsE.z * 2.5;
+    r.tc3.zw = tc0.zw * 90.0  - w.paramsE.z * 2.0;
+    r.tc4.xy = tc0.zw * 2.0;
+    r.tc4.zw = tc0.zw * 6.0 + w.paramsE.z * 0.37;
+    float3 wave = pos;
+    wave.y = 3.0 * (cos(w.paramsE.z * 500.0 + pos4.z) * sin(w.paramsE.z * 500.0 + pos4.x / 1000.0));
+    r.eyeVec = w.eyePos.xyz - wave;
+    r.ligVec = normalize(w.sunDir.xyz * 20000.0 + w.mapMid.xyz - wave);
+    r.worldPos = wave;
+    float4 clip = s.viewProjection * float4(wave, 1.0);
+    clip.y = -clip.y;
+    if (s.fog.z == 0.0) clip.z = (clip.z + clip.w) * 0.5;
+    r.position = clip;
+    r.fogZ = (s.viewProjection * float4(wave, 1.0)).z;
+    return r;
+}
+float waterShadow(float3 worldPos, constant WaterU& w, constant Scene& s,
+                  depth2d<float> shadowTex, sampler shadowSampler, texture2d<float> shadowColor, sampler samp) {
+#ifdef OPT_SHADOWS
+    float4 sp = s.shadowMatrix * float4(worldPos, 1.0);
+    sp.xy += float2(0.5, 0.5);
+    float3 ndc = sp.xyz / max(sp.w, 0.0001);
+    if (ndc.x < 0.0 || ndc.x > 1.0 || ndc.y < 0.0 || ndc.y > 1.0) return 1.0;
+    float sh = shadowTex.sample_compare(shadowSampler, ndc.xy, ndc.z - 0.0015);
+    float3 shColor = shadowColor.sample(samp, ndc.xy).rgb;
+    return mix(1.0, sh, w.paramsE.y) * (shColor.r + shColor.g + shColor.b) / 3.0;
+#endif
+    return 1.0;
+}
+float ConvertEyeZ(float d, constant WaterU& w) {
+    return w.viewPos.z / (d * -2.0 + 1.0 - w.viewPos.w);
+}
+fragment float4 waterFragment(WaterRaster r [[stage_in]],
+                              constant Scene& s [[buffer(1)]],
+                              constant WaterU& w [[buffer(3)]],
+                              texture2d<float> normalTex [[texture(0)]],
+                              texture2d<float> shadeTex [[texture(1)]],
+                              texture2d<float> causticTex [[texture(2)]],
+                              texture2d<float> foamTex [[texture(3)]],
+                              texture2d<float> reflectTex [[texture(4)]],
+                              texture2d<float> refractTex [[texture(5)]],
+                              texture2d<float> coastTex [[texture(6)]],
+                              texture2d<float> depthTex [[texture(7)]],
+                              texture2d<float> waverandTex [[texture(8)]],
+                              depth2d<float> shadowTex [[texture(9)]],
+                              texture2d<float> infoTex [[texture(10)]],
+                              texture2d<float> shadowColorTex [[texture(11)]],
+                              sampler samp [[sampler(0)]],
+                              sampler shadowSamp [[sampler(3)]]) {
+    float2 screenPos = r.position.xy - w.viewPos.xy;
+    float2 screencoord = screenPos * w.screen.zw;
+    float2 reftexcoord = screenPos * w.screen.xy;
+    // water depth
+    float invwaterdepth = shadeTex.sample(samp, r.tc0.xy).a;
+    float outside = 0.0;
+#ifdef OPT_ENDLESS
+    float2 clampedWP = clamp(r.worldPos.xz, float2(0.0), float2(1.0) / w.texGenPlane.xy);
+    outside = min(1.0, distance(clampedWP, r.worldPos.xz));
+    invwaterdepth = mix(invwaterdepth, 1.0, step(0.5, outside));
+#endif
+    float waterdepth = 1.0 - invwaterdepth;
+    // normal octaves
+    float3 o1 = normalTex.sample(samp, r.tc1.xy).rgb;
+    float3 o2 = normalTex.sample(samp, r.tc1.zw).rgb;
+    float3 o3 = normalTex.sample(samp, r.tc2.xy).rgb;
+    float3 o4 = normalTex.sample(samp, r.tc2.zw).rgb;
+    float a = w.paramsC.z;
+    float3 normal = normalize(((o1*2.0-1.0)*a + (o2*2.0-1.0)*a*a + (o3*2.0-1.0)*a*a*a + (o4*2.0-1.0)*a*a*a*a).xzy);
+    float3 eVec = normalize(r.eyeVec);
+    float eyeNormalCos = dot(-eVec, normal);
+    float angle = 1.0 - abs(eyeNormalCos);
+    float shadowOcc = waterShadow(r.worldPos + float3(normal.x, 0.0, normal.z) * 10.0, w, s, shadowTex, shadowSamp, shadowColorTex, samp);
+    float3 reflectDir = reflect(normalize(-r.ligVec), normal);
+#ifdef OPT_DEPTH
+    float fragEyeZ = w.viewPos.z / (r.position.z * -2.0 + 1.0 - w.viewPos.w);
+    float shallowScale = clamp(abs(ConvertEyeZ(depthTex.sample(samp, screencoord).r, w) - fragEyeZ) * 0.333, 0.0, 1.0);
+#else
+    float shallowScale = waterdepth;
+#endif
+    float specular = angle * pow(max(dot(reflectDir, eVec), 0.0), w.specularColor.w) * w.paramsA.y * shallowScale;
+    float3 sunLow = w.sunDir.xyz * float3(1.0, 0.1, 1.0);
+    float diffuse = pow(max(dot(normal, sunLow), 0.0), 3.0) * w.diffuseColor.w;
+    float ambient = smoothstep(-1.3, 0.0, eyeNormalCos) * w.paramsA.x;
+    float3 waterSurface = w.surfaceColor.rgb + w.diffuseColor.rgb * diffuse + float3(ambient);
+    float surfaceMix = (w.surfaceColor.a + diffuse) * shallowScale;
+    float3 info = float3(0.0);
+#ifdef OPT_INFOTEX
+    float2 clampedPot = w.shadingPlane.xy * clamp(r.worldPos.xz, float2(0.0), float2(1.0) / w.texGenPlane.xy);
+    info = (infoTex.sample(samp, clampedPot).rgb - 0.5) * 0.5;
+    info = mix(info, float3(0.0), outside);
+#endif
+    waterSurface += info;
+    float3 rgb;
+    float alpha = 1.0;
+#ifdef OPT_REFRACTION
+    float refractDistortion = 60.0 * (1.0 - pow(r.position.z, 80.0)) * shallowScale;
+    float2 refrUV = screencoord + normal.xz * refractDistortion * w.screen.xy;
+    float3 refrColor = refractTex.sample(samp, refrUV).rgb;
+    float texZ = ConvertEyeZ(depthTex.sample(samp, refrUV).r, w);
+    float fragZ = ConvertEyeZ(r.position.z, w);
+    float mixback = clamp(texZ - fragZ, 0.0, 1.0);
+    float3 origRefr = refractTex.sample(samp, screencoord).rgb;
+    refrColor = mix(refrColor, origRefr, mixback);
+    rgb = mix(refrColor, waterSurface, 0.1 + surfaceMix * 0.100);
+#else
+    rgb = waterSurface;
+    alpha = surfaceMix + specular;
+#endif
+    if (waterdepth > 0.0) {
+        float3 caust = causticTex.sample(samp, r.tc0.zw * w.paramsD.w).rgb;
+#ifdef OPT_REFRACTION
+        float caustBlend = smoothstep(0.45, 0.0, abs(waterdepth - 0.5));
+        rgb += caust * caustBlend * w.paramsE.x;
+#else
+        alpha *= min(waterdepth * 4.0, 1.0);
+        rgb += caust * (1.0 - waterdepth) * 7.5 * w.paramsE.x;
+#endif
+    }
+#ifdef OPT_SHORE
+    {
+        float3 coast = coastTex.sample(samp, r.tc0.xy).rgb;
+        float coastdist = coast.g + o3.x * 0.1;
+        float3 shore = float3(0.0);
+        if (coastdist > 0.0) {
+            float underground = 1.0 - step(1.0, invwaterdepth);
+            float3 wavefoam = foamTex.sample(samp, r.tc3.xy + o3.xy * w.paramsD.y).rgb;
+            wavefoam += foamTex.sample(samp, r.tc3.zw + o3.xy * w.paramsD.y).rgb;
+            wavefoam *= w.paramsD.z;
+            float4 waverands = waverandTex.sample(samp, r.tc4.zw);
+            float4 fi = float4(0.25, 0.50, 0.75, 1.00);
+            float4 fw = fract(fi + w.paramsE.z * 50.0 + (r.tc1.x + r.tc1.y) * w.paramsC.w);
+            fw = fw * 1.4 - float4(coastdist);
+            fw = float4(1.0) - fw * (1.0 / w.paramsD.x);
+            fw = clamp(fw, 0.0, 1.0);
+            float4 front = float4(1.0) - abs(fw - float4(0.85)) / float4(0.15);
+            front = max(front, select(float4(0.0), float4(1.0), fw < float4(0.85)) * fw * 0.5);
+            float intensity = dot(front, waverands) * coastdist;
+            float iwd = mix(invwaterdepth, invwaterdepth - (fmod(invwaterdepth, 0.8) * 0.8) / (1.0 - 0.8), step(0.8, invwaterdepth));
+            intensity *= iwd * 1.5;
+            shore += wavefoam * underground * intensity;
+            shore += (wavefoam * wavefoam) * (underground * 5.5 * pow(coast.r, 3.0) * pow(coastdist, 4.0));
+        }
+        rgb += shadowOcc * shore;
+    }
+#endif
+    // NOTE: shore contribution with shadow multiply applied here to match GLSL order
+    rgb = rgb; // (shore block above already added unshadowed; corrected below)
+    float fresnel = 0.0;
+    float3 reflColor = float3(0.0);
+#ifdef OPT_REFLECTION
+    {
+        float2 rtc = float2(reftexcoord.x, 1.0 - reftexcoord.y);
+        rtc += float2(0.0, 3.0 * w.screen.y) + normal.xz * 0.09 * w.paramsB.y;
+        reflColor = reflectTex.sample(samp, rtc).rgb;
+#ifdef OPT_BLURREFL
+        float2 v = float2(0.0, w.paramsB.z);
+        float se = w.paramsB.w;
+        reflColor += reflectTex.sample(samp, rtc + v).rgb;
+        reflColor += reflectTex.sample(samp, rtc + v * se).rgb;
+        reflColor += reflectTex.sample(samp, rtc + v * se * se).rgb;
+        reflColor += reflectTex.sample(samp, rtc + v * se * se * se).rgb;
+        reflColor += reflectTex.sample(samp, rtc + v * se * se * se * se).rgb;
+        reflColor += reflectTex.sample(samp, rtc + v * se * se * se * se * se).rgb;
+        reflColor += reflectTex.sample(samp, rtc + v * se * se * se * se * se * se).rgb;
+        reflColor *= 0.125;
+#endif
+        fresnel = w.paramsA.z + w.paramsA.w * pow(angle, w.paramsB.x);
+    }
+#endif
+    rgb = mix(rgb, reflColor, fresnel * shallowScale);
+    rgb += shadowOcc * specular * w.specularColor.rgb;
+    float fogF = clamp((w.fog.w - abs(r.fogZ)) * w.mapMid.w, 0.0, 1.0);
+    rgb = mix(w.fog.rgb, rgb, fogF);
+    return float4(rgb, alpha);
+}
+
+)MSL";
+
+[[noreturn]] void Fail(const std::string& reason) {
+	throw content_error("NativeMetalWorld: " + reason);
+}
+std::string ErrorText(NSError* error) {
+	return error == nil ? "unknown Metal error" : std::string([[error localizedDescription] UTF8String]);
+}
+void Copy(float* dst, const float4& src) { std::memcpy(dst, &src.x, sizeof(float) * 4); }
+void Matrix(float* dst, const CMatrix44f& src) { std::memcpy(dst, src.m, sizeof(float) * 16); }
