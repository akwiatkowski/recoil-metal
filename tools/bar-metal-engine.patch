+		[encoder setFragmentBuffer:waterUniforms offset:0 atIndex:3];
+		id<MTLTexture> blanks[12] = {t_normal, t_shade, t_caustic, t_foam, t_reflect, t_refract, t_coast, t_depth, t_wave, t_shadow, t_info, t_shadowColor};
+		for (int i = 0; i < 12; ++i) { if (blanks[i] == nil) blanks[i] = (i == 9) ? (id<MTLTexture>)whiteShadow : whiteColor; }
+		[encoder setFragmentSamplerState:unitSampler atIndex:0];
+		[encoder setFragmentSamplerState:shadowSampler atIndex:3];
+		for (int i = 0; i < 12; ++i) { if (i != 9) [encoder setFragmentTexture:blanks[i] atIndex:i]; }
+		id<MTLTexture> shadowDepth = (t_shadow != nil) ? t_shadow : whiteShadow;
+		[encoder setFragmentTexture:shadowDepth atIndex:9];
+		[encoder drawIndexedPrimitives:waterPrimitive indexCount:waterIndexCount indexType:MTLIndexTypeUInt32 indexBuffer:waterIndexBuffer indexBufferOffset:0];
+		uint64_t triangles = waterIndexCount / 3;
+		Complete(encoder, command, "water", waterLogged, triangles);
+	}
+};
+
+std::unique_ptr<Renderer> renderer;
+Renderer& GetRenderer() {
+	if (renderer == nullptr) renderer = std::make_unique<Renderer>();
+	return *renderer;
+}
