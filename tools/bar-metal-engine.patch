+bool NativeMetalWorld::QueueAlphaUnit(CUnit* unit) {
+	if (renderer == nullptr || !renderer->collecting) return false;
+	if (unit->model->type != MODELTYPE_S3O || unit->luaDraw) return false;
+	{
+		const auto* material = textureHandlerS3O.GetTexture(unit->model->textureType);
+		if (material == nullptr) return false;
+		if (!renderer->ProbeMaterial(material->tex1, material->tex2, "alphaUnits")) return false;
+	}
+	renderer->alphaUnits.push_back(unit);
+	return true;
+}
+bool NativeMetalWorld::QueueAlphaFeature(CFeature* feature) {
+	if (renderer == nullptr || !renderer->collecting) return false;
+	if (feature->model->type != MODELTYPE_S3O || feature->luaDraw) return false;
+	{
+		const auto* material = textureHandlerS3O.GetTexture(feature->model->textureType);
+		if (material == nullptr) return false;
+		if (!renderer->ProbeMaterial(material->tex1, material->tex2, "alphaFeatures")) return false;
+	}
+	renderer->alphaFeatures.push_back(feature);
+	return true;
+}
+bool NativeMetalWorld::QueueProjectile(CProjectile* projectile, int modelType) {
+	if (renderer == nullptr || !renderer->collecting || !renderer->forwardProjectilePass) return false;
+	// Only static S3O weapon models without Lua overrides; piece projectiles,
+	// billboards and flying pieces stay on compatibility.
+	if (!projectile->weapon || modelType != MODELTYPE_S3O || projectile->model == nullptr ||
+	    projectile->model->type != MODELTYPE_S3O || projectile->luaDraw) return false;
+	{
+		const auto* material = textureHandlerS3O.GetTexture(projectile->model->textureType);
+		if (material == nullptr) return false;
+		if (!renderer->ProbeMaterial(material->tex1, material->tex2, "units")) return false;
+	}
+	const CWeaponProjectile* wp = static_cast<const CWeaponProjectile*>(projectile);
+	ProjectileDraw pd;
+	pd.p = projectile;
+	pd.matrix = wp->GetTransformMatrix(wp->GetProjectileType() == WEAPON_MISSILE_PROJECTILE);
+	pd.team = wp->GetTeamID();
+	renderer->projectiles.push_back(pd);
+	return true;
+}
+bool NativeMetalWorld::QueueFeature(CFeature* feature) {
+	if (renderer == nullptr || !renderer->collecting || !renderer->forwardUnitPass) return false;
+	// Custom Lua materials and non-S3O geometry stay on compatibility.
+	if (feature->model->type != MODELTYPE_S3O || feature->luaDraw) return false;
+	{
+		const auto* material = textureHandlerS3O.GetTexture(feature->model->textureType);
+		if (material == nullptr) return false;
+		if (!renderer->ProbeMaterial(material->tex1, material->tex2, "units")) return false;
+	}
+	renderer->features.push_back(feature);
+	return true;
+}
+bool NativeMetalWorld::QueueUnit(CUnit* unit) {
+	if (renderer == nullptr || !renderer->collecting || !renderer->forwardUnitPass) return false;
+	// 3DO atlases, custom Lua draw callbacks, and construction visualization
+	// retain their original compatibility renderer and are never double drawn.
+	if (unit->model->type != MODELTYPE_S3O || unit->luaDraw ||
+		(unit->beingBuilt && unit->unitDef->showNanoFrame)) return false;
+	{
+		const auto* material = textureHandlerS3O.GetTexture(unit->model->textureType);
+		if (material == nullptr) return false;
+		if (!renderer->ProbeMaterial(material->tex1, material->tex2, "units")) return false;
+	}
+	renderer->units.push_back(unit);
+	return true;
+}
+bool NativeMetalWorld::SetUnitPass(bool forward) {
+	if (renderer == nullptr) return false;
+	const bool previous = renderer->forwardUnitPass;
+	renderer->forwardUnitPass = forward;
+	return previous;
+}
+void NativeMetalWorld::Kill() { renderer.reset(); }
