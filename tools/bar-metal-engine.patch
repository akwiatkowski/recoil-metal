+	Frame BorrowFrame() {
+		// Deliberate initial hybrid synchronization: this blocks the CPU and
+		// both queues twice per world frame. No attachment survives the call.
+		glFinish();
+		void* color = nullptr;
+		void* depth = nullptr;
+		if (!abi.frame(&color, &depth) || color == nullptr || depth == nullptr)
+			Fail("current GL draw framebuffer cannot export a window-oriented single-color/depth Metal target");
+		Frame f{(__bridge id<MTLTexture>)color, (__bridge id<MTLTexture>)depth};
+	// Kosmickrisp swapchain drawables arrive as a single-slice 2D array. A 2D
+	// slice view shares the same storage (no copy) and is only used inside the
+	// synchronized borrow window; anything else is rejected, not reinterpreted.
+	id<MTLTexture> colorView = nil;
+	if (f.color.textureType == MTLTextureType2DArray && f.color.arrayLength == 1 &&
+	    f.color.mipmapLevelCount == 1) {
+		colorView = [f.color newTextureViewWithPixelFormat:f.color.pixelFormat
+		    textureType:MTLTextureType2D levels:NSMakeRange(0, 1) slices:NSMakeRange(0, 1)];
+		if (colorView == nil) Fail("cannot create 2D view of single-slice array framebuffer");
+		f.color = colorView;
+	}
+		if (f.color.textureType != MTLTextureType2D || f.depth.textureType != MTLTextureType2D ||
+			f.color.sampleCount != 1 || f.depth.sampleCount != 1 ||
+			f.color.width != f.depth.width || f.color.height != f.depth.height ||
+			f.color.device != f.depth.device)
+			Fail("unsupported Metal framebuffer shape, device, or multisampling");
+		switch (f.color.pixelFormat) {
+			case MTLPixelFormatBGRA8Unorm: case MTLPixelFormatRGBA8Unorm:
+			case MTLPixelFormatBGRA8Unorm_sRGB: case MTLPixelFormatRGBA8Unorm_sRGB:
+			case MTLPixelFormatRGBA16Float: break;
+			default: Fail("unsupported Metal framebuffer color format");
+		}
+		switch (f.depth.pixelFormat) {
+			case MTLPixelFormatDepth16Unorm: case MTLPixelFormatDepth32Float:
+			case MTLPixelFormatDepth32Float_Stencil8: case MTLPixelFormatDepth24Unorm_Stencil8: break;
+			default: Fail("unsupported Metal framebuffer depth format");
+		}
+		if (device == nil) Init(f.color.device);
+		if (device != f.color.device) Fail("GL changed Metal device during the world renderer lifetime");
+		return f;
+	}
+
+	void Init(id<MTLDevice> borrowedDevice) {
+		device = borrowedDevice;
+		queue = [device newCommandQueue];
+		NSError* error = nil;
+		library = [device newLibraryWithSource:[NSString stringWithUTF8String:metalSource] options:nil error:&error];
+		if (queue == nil || library == nil) Fail("cannot create direct MSL library/queue: " + ErrorText(error));
+		MTLDepthStencilDescriptor* depth = [MTLDepthStencilDescriptor new];
+		depth.depthCompareFunction = MTLCompareFunctionLessEqual;
+		depth.depthWriteEnabled = YES;
+		depthState = [device newDepthStencilStateWithDescriptor:depth];
+	MTLDepthStencilDescriptor* alphaDepthDesc = [MTLDepthStencilDescriptor new];
+	alphaDepthDesc.depthCompareFunction = MTLCompareFunctionLessEqual;
+	alphaDepthDesc.depthWriteEnabled = NO;
+	alphaDepthState = [device newDepthStencilStateWithDescriptor:alphaDepthDesc];
+		MTLSamplerDescriptor* sampler = [MTLSamplerDescriptor new];
+		sampler.minFilter = MTLSamplerMinMagFilterLinear;
+		sampler.magFilter = MTLSamplerMinMagFilterLinear;
+		sampler.mipFilter = MTLSamplerMipFilterLinear;
+		sampler.maxAnisotropy = 8;
+		sampler.sAddressMode = MTLSamplerAddressModeClampToEdge;
+		sampler.tAddressMode = MTLSamplerAddressModeClampToEdge;
+		tileSampler = [device newSamplerStateWithDescriptor:sampler];
+		sampler.sAddressMode = MTLSamplerAddressModeRepeat;
+		sampler.tAddressMode = MTLSamplerAddressModeRepeat;
+		unitSampler = [device newSamplerStateWithDescriptor:sampler];
+	MTLSamplerDescriptor* shadowDesc = [MTLSamplerDescriptor new];
+	shadowDesc.minFilter = MTLSamplerMinMagFilterLinear;
+	shadowDesc.magFilter = MTLSamplerMinMagFilterLinear;
+	shadowDesc.mipFilter = MTLSamplerMipFilterNotMipmapped;
+	shadowDesc.sAddressMode = MTLSamplerAddressModeClampToBorderColor;
+	shadowDesc.tAddressMode = MTLSamplerAddressModeClampToBorderColor;
+	shadowDesc.borderColor = MTLSamplerBorderColorOpaqueWhite;
+	shadowDesc.compareFunction = MTLCompareFunctionLess;
+	shadowSampler = [device newSamplerStateWithDescriptor:shadowDesc];
+	// Satisfies Metal resource validation on the shadow slot when shadows
+	// are off; the shader early-outs before sampling it.
+	MTLTextureDescriptor* whiteDesc = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatDepth32Float width:1 height:1 mipmapped:NO];
+	whiteDesc.storageMode = MTLStorageModeShared;
+	whiteShadow = [device newTextureWithDescriptor:whiteDesc];
+	if (whiteShadow == nil) Fail("cannot allocate shadow fallback texture");
+	MTLTextureDescriptor* whiteColorDesc = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm width:1 height:1 mipmapped:NO];
+	whiteColorDesc.storageMode = MTLStorageModeShared;
+	whiteColor = [device newTextureWithDescriptor:whiteColorDesc];
+	if (whiteColor == nil) Fail("cannot allocate color fallback texture");
+		sceneBuffer = [device newBufferWithLength:sizeof(Scene) options:MTLResourceStorageModeShared];
+		if (depthState == nil || alphaDepthState == nil || tileSampler == nil || unitSampler == nil || shadowSampler == nil || sceneBuffer == nil)
+			Fail("cannot allocate cached Metal scene state");
+		std::vector<uint32_t> indices;
+		indices.reserve(TILE_SIZE * TILE_SIZE * 6);
+		for (unsigned z = 0; z < TILE_SIZE; ++z) {
+			for (unsigned x = 0; x < TILE_SIZE; ++x) {
+				const uint32_t a = z * (TILE_SIZE + 1) + x;
+				const uint32_t b = a + 1, c = a + TILE_SIZE + 1, d = c + 1;
+				indices.insert(indices.end(), {a, c, b, b, c, d});
+			}
+		}
+		tileIndices = [device newBufferWithBytes:indices.data() length:indices.size() * sizeof(uint32_t) options:MTLResourceStorageModeShared];
+		if (tileIndices == nil) Fail("cannot allocate immutable terrain index mesh");
+	}
+
+	static bool HasStencil(id<MTLTexture> depth) {
+		return depth.pixelFormat == MTLPixelFormatDepth32Float_Stencil8 || depth.pixelFormat == MTLPixelFormatDepth24Unorm_Stencil8;
+	}
+	Pipelines& GetPipelines(const Frame& f) {
+		const uint64_t key = (uint64_t(f.color.pixelFormat) << 32) | uint64_t(f.depth.pixelFormat);
+		auto it = pipelines.find(key);
+		if (it != pipelines.end()) return it->second;
+		MTLRenderPipelineDescriptor* desc = [MTLRenderPipelineDescriptor new];
+		desc.colorAttachments[0].pixelFormat = f.color.pixelFormat;
+		desc.depthAttachmentPixelFormat = f.depth.pixelFormat;
+		desc.stencilAttachmentPixelFormat = HasStencil(f.depth) ? f.depth.pixelFormat : MTLPixelFormatInvalid;
+		desc.rasterSampleCount = 1;
+		Pipelines result;
+		NSError* error = nil;
+		desc.vertexFunction = [library newFunctionWithName:@"terrainVertex"];
+		desc.fragmentFunction = [library newFunctionWithName:@"terrainFragment"];
+		result.terrain = [device newRenderPipelineStateWithDescriptor:desc error:&error];
+		if (result.terrain == nil) Fail("cannot create terrain Metal pipeline: " + ErrorText(error));
+		desc.vertexFunction = [library newFunctionWithName:@"unitVertex"];
+		desc.fragmentFunction = [library newFunctionWithName:@"unitFragment"];
+		result.unit = [device newRenderPipelineStateWithDescriptor:desc error:&error];
+		if (result.unit == nil) Fail("cannot create unit Metal pipeline: " + ErrorText(error));
+		desc.vertexFunction = [library newFunctionWithName:@"unitVertex"];
+		desc.fragmentFunction = [library newFunctionWithName:@"unitAlphaFragment"];
+		desc.colorAttachments[0].blendingEnabled = YES;
+		desc.colorAttachments[0].sourceRGBBlendFactor = MTLBlendFactorSourceAlpha;
+		desc.colorAttachments[0].destinationRGBBlendFactor = MTLBlendFactorOneMinusSourceAlpha;
+		desc.colorAttachments[0].sourceAlphaBlendFactor = MTLBlendFactorOne;
+		desc.colorAttachments[0].destinationAlphaBlendFactor = MTLBlendFactorOneMinusSourceAlpha;
+		result.unitAlpha = [device newRenderPipelineStateWithDescriptor:desc error:&error];
+		if (result.unitAlpha == nil) Fail("cannot create unit alpha Metal pipeline: " + ErrorText(error));
+		return pipelines.emplace(key, result).first->second;
+	}
+
+	id<MTLTexture> BorrowTexture(unsigned name) {
+		id<MTLTexture> texture = (__bridge id<MTLTexture>)abi.texture(name);
+		// Kosmickrisp backs ordinary 2D Vulkan images with single-slice 2D
+		// array Metal textures. The slice view shares storage (no copy) and
+		// lives only inside the synchronized borrow window.
+		if (texture != nil && texture.textureType == MTLTextureType2DArray &&
+		    texture.arrayLength == 1 && texture.mipmapLevelCount >= 1) {
+			texture = [texture newTextureViewWithPixelFormat:texture.pixelFormat
+			    textureType:MTLTextureType2D levels:NSMakeRange(0, texture.mipmapLevelCount) slices:NSMakeRange(0, 1)];
+		}
+		if (texture == nil || texture.device != device || texture.textureType != MTLTextureType2D || texture.sampleCount != 1)
+			return nil;
+		return texture;
+	}
+	// Transient streaming storage (unconsolidated mips) resolves within frames.
+	// Skipped objects pop back once resident; each id logs once. Only the frame
+	// attachments and the heightmap are fatal, since nothing can proceed.
+	std::unordered_set<unsigned> skipLogged;
+	id<MTLTexture> BorrowMaterial(unsigned name, const char* pass) {
+		id<MTLTexture> texture = BorrowTexture(name);
+		if (texture == nil && skipLogged.insert(name).second)
+			LOG("BAR-METAL %s material %u unavailable, skipping object until resident", pass, name);
+		return texture;
+	}
+	void ReserveDraws(size_t needed) {
+		if (needed <= drawCapacity) return;
+		drawCapacity = std::max(needed, std::max(size_t(256), drawCapacity * 2));
+		drawBuffer = [device newBufferWithLength:drawCapacity * DRAW_STRIDE options:MTLResourceStorageModeShared];
+		if (drawBuffer == nil) Fail("cannot grow dynamic Metal draw uniforms");
+	}
+	Draw& DrawAt(size_t i) {
+		return *reinterpret_cast<Draw*>(static_cast<char*>(drawBuffer.contents) + i * DRAW_STRIDE);
+	}
+	bool ProbeMaterial(unsigned tex1, unsigned tex2, const char* pass) {
+		// Conservative pre-check during collection (no GPU sync, pure query).
+		// Textures with permanently split mip storage (e.g. wreck atlases
+		// with redefined levels) stay on compatibility; compat still draws
+		// them, so nothing vanishes. A NULL here only misses an opportunity;
+		// BorrowMaterial remains the post-glFinish safety net for races.
+		bool ok = abi.texture(tex1) != nullptr && abi.texture(tex2) != nullptr;
+		if (!ok) {
+			unsigned id = abi.texture(tex1) == nullptr ? tex1 : tex2;
+			if (skipLogged.insert(id).second)
+				LOG("BAR-METAL %s material %u stays compat (split storage)", pass, id);
+		}
+		return ok;
+	}
+	id<MTLTexture> BorrowShadow() {
+		// The compat shadow pass wrote this depth texture during
+		// GenerateIBLTextures; borrowing needs no extra GL work here.
+		if (!shadowHandler.ShadowsLoaded())
+			return nil;
+		id<MTLTexture> shadow = BorrowTexture(shadowHandler.GetShadowTextureID());
+		if (shadow.pixelFormat != MTLPixelFormatDepth32Float &&
+		    shadow.pixelFormat != MTLPixelFormatDepth16Unorm &&
+		    shadow.pixelFormat != MTLPixelFormatDepth32Float_Stencil8 &&
+		    shadow.pixelFormat != MTLPixelFormatDepth24Unorm_Stencil8)
+			Fail("shadow depth texture has an unsupported Metal pixel format");
+		return shadow;
+	}
+	void SetScene(bool terrain) {
+		Scene& s = *static_cast<Scene*>(sceneBuffer.contents);
+		Matrix(s.viewProjection, camera->GetViewProjectionMatrix());
+		const float3& eye = camera->GetPos();
+		s.eye[0] = eye.x; s.eye[1] = eye.y; s.eye[2] = eye.z; s.eye[3] = 1.0f;
+		Copy(s.sun, ISky::GetSky()->GetLight()->GetLightDir());
+		Copy(s.ambient, terrain ? sunLighting->groundAmbientColor : sunLighting->modelAmbientColor);
+		Copy(s.diffuse, terrain ? sunLighting->groundDiffuseColor : sunLighting->modelDiffuseColor);
+		Copy(s.specular, sunLighting->modelSpecularColor);
+		s.specular[3] = sunLighting->specularExponent;
+		Copy(s.fogColor, ISky::GetSky()->fogColor);
+		s.fog[0] = ISky::GetSky()->fogStart * camera->GetFarPlaneDist();
+		s.fog[1] = ISky::GetSky()->fogEnd * camera->GetFarPlaneDist();
+		if (!globalRendering->drawFog) { s.fog[0] = 1.0e20f; s.fog[1] = 2.0e20f; }
+		s.fog[2] = globalRendering->supportClipSpaceControl ? 1.0f : 0.0f;
+		s.fog[3] = terrain && (mapRendering->voidGround || mapRendering->voidWater) ? mapInfo->map.voidAlphaMin : -1.0f;
+		// Shadow-map receive: compat GenerateIBLTextures already rendered the
+		// depth map this frame; sample it with the engine drawing matrix.
+		if (shadowHandler.ShadowsLoaded()) {
+			Matrix(s.shadowMatrix, shadowHandler.GetShadowMatrix());
+			s.shadow[0] = terrain ? sunLighting->groundShadowDensity : sunLighting->modelShadowDensity;
+			s.shadow[1] = 0.0015f;
+			s.shadow[2] = 1.0f;
+		} else {
+			s.shadow[0] = 1.0f; s.shadow[1] = 0.0f; s.shadow[2] = 0.0f;
+		}
+		s.shadow[3] = 0.0f;
+	}
+
+	id<MTLRenderCommandEncoder> Begin(const Frame& f, id<MTLCommandBuffer> command) {
+		MTLRenderPassDescriptor* pass = [MTLRenderPassDescriptor renderPassDescriptor];
+		pass.colorAttachments[0].texture = f.color;
+		pass.colorAttachments[0].loadAction = MTLLoadActionLoad;
+		pass.colorAttachments[0].storeAction = MTLStoreActionStore;
+		pass.depthAttachment.texture = f.depth;
+		pass.depthAttachment.loadAction = MTLLoadActionLoad;
+		pass.depthAttachment.storeAction = MTLStoreActionStore;
+		if (HasStencil(f.depth)) {
+			pass.stencilAttachment.texture = f.depth;
+			pass.stencilAttachment.loadAction = MTLLoadActionLoad;
+			pass.stencilAttachment.storeAction = MTLStoreActionStore;
+		}
+		id<MTLRenderCommandEncoder> encoder = [command renderCommandEncoderWithDescriptor:pass];
+		if (encoder == nil) Fail("cannot encode borrowed world framebuffer");
+		GLint viewport[4]; GLdouble depthRange[2];
+		glGetIntegerv(GL_VIEWPORT, viewport);
+		glGetDoublev(GL_DEPTH_RANGE, depthRange);
+		if (viewport[0] < 0 || viewport[1] < 0 || viewport[2] <= 0 || viewport[3] <= 0 ||
+			uint64_t(viewport[0] + viewport[2]) > f.color.width || uint64_t(viewport[1] + viewport[3]) > f.color.height)
+			Fail("GL viewport outside exported Metal attachment");
+		[encoder setViewport:MTLViewport{double(viewport[0]), double(f.color.height) - viewport[1] - viewport[3], double(viewport[2]), double(viewport[3]), depthRange[0], depthRange[1]}];
+		[encoder setDepthStencilState:depthState];
+		// Engine model-space has mirrored Z. The FlipY clip conversion also
+		// reverses winding relative to compatibility GL's CCW front faces.
+		[encoder setFrontFacingWinding:MTLWindingClockwise];
+		[encoder setCullMode:MTLCullModeBack];
+		[encoder setVertexBuffer:sceneBuffer offset:0 atIndex:1];
+		[encoder setFragmentBuffer:sceneBuffer offset:0 atIndex:1];
+		return encoder;
+	}
+	void Complete(id<MTLRenderCommandEncoder> encoder, id<MTLCommandBuffer> command, const char* pass, bool& logged, uint64_t triangles) {
+		[encoder endEncoding];
+		[command commit];
+		[command waitUntilCompleted];
+		if (command.status != MTLCommandBufferStatusCompleted)
+			Fail("native world command buffer failed: " + ErrorText(command.error));
+		if (!logged && triangles != 0) {
+			LOG("BAR-METAL %s triangles=%llu", pass, static_cast<unsigned long long>(triangles));
+			logged = true;
+		}
+	}
+	Mesh& GetMesh(const S3DModelPiece* piece) {
+		auto it = meshes.find(piece);
+		if (it != meshes.end()) return it->second;
+		const auto& source = piece->GetVerticesVec();
+		const auto& indices = piece->GetIndicesVec();
+		if (source.empty() || indices.empty() || indices.size() % 3 != 0)
+			Fail("model CPU geometry is unavailable or not triangular");
+		std::vector<Vertex> vertices(source.size());
+		for (size_t i = 0; i < source.size(); ++i) {
+			std::memcpy(vertices[i].position, &source[i].pos.x, sizeof(float) * 3);
+			std::memcpy(vertices[i].normal, &source[i].normal.x, sizeof(float) * 3);
+			std::memcpy(vertices[i].uv, &source[i].texCoords[0].x, sizeof(float) * 2);
+		}
+		for (uint32_t index : indices) if (index >= vertices.size()) Fail("model piece index outside CPU geometry");
+		Mesh mesh;
+		mesh.vertices = [device newBufferWithBytes:vertices.data() length:vertices.size() * sizeof(Vertex) options:MTLResourceStorageModeShared];
+		mesh.indices = [device newBufferWithBytes:indices.data() length:indices.size() * sizeof(uint32_t) options:MTLResourceStorageModeShared];
+		mesh.indexCount = indices.size();
+		if (mesh.vertices == nil || mesh.indices == nil) Fail("cannot upload immutable model piece geometry");
+		return meshes.emplace(piece, mesh).first->second;
+	}
+
+	void Terrain(CSMFReadMap& map, CSMFGroundTextures& textures) {
+		Frame f = BorrowFrame();
+		if (map.bigTexSize != int(TILE_SIZE * SQUARE_SIZE)) Fail("unsupported SMF diffuse tile dimensions");
+		ReserveDraws(size_t(map.numBigTexX) * map.numBigTexY);
+		SetScene(true);
+		id<MTLTexture> heights = BorrowTexture(map.GetHeightMapTexture());
+		if (heights == nil) Fail("SMF height texture is not borrowable");
+		if (heights.pixelFormat != MTLPixelFormatR32Float || heights.width != size_t(mapDims.mapxp1) || heights.height != size_t(mapDims.mapyp1))
+			Fail("SMF live height texture must be full-resolution R32Float corner data");
+		id<MTLCommandBuffer> command = [queue commandBuffer];
+		if (command == nil) Fail("cannot create terrain command buffer");
+		command.label = @"BAR-METAL terrain";
+		id<MTLRenderCommandEncoder> encoder = Begin(f, command);
+		[encoder setRenderPipelineState:GetPipelines(f).terrain];
+		[encoder setVertexTexture:heights atIndex:0];
+		[encoder setFragmentSamplerState:tileSampler atIndex:0];
+		id<MTLTexture> terrainShadow = BorrowShadow();
+		if (terrainShadow != nil) {
+			[encoder setFragmentTexture:terrainShadow atIndex:3];
+		} else {
+			[encoder setFragmentTexture:whiteShadow atIndex:3];
+		}
+		[encoder setFragmentSamplerState:shadowSampler atIndex:3];
+		size_t draw = 0;
+		uint64_t triangles = 0;
+		for (int z = 0; z < map.numBigTexY; ++z) {
+			for (int x = 0; x < map.numBigTexX; ++x) {
+				const float3& bounds = map.GetUnsyncedHeightInfo(x, z);
+				const float ox = x * map.bigTexSize, oz = z * map.bigTexSize;
+				if (!camera->InView(float3(ox, bounds.x, oz), float3(ox + map.bigTexSize, bounds.y, oz + map.bigTexSize))) continue;
+				Draw& d = DrawAt(draw);
+				d.tile[0] = x * TILE_SIZE; d.tile[1] = z * TILE_SIZE; d.tile[2] = TILE_SIZE; d.tile[3] = 0.0f;
+				// ReadMap already updates dirty unsynced height texture rectangles
+				// after LOS permits them. Sampling that live texture also updates
+				// native normals without copying/rebuilding a mesh or exposing
+				// unseen enemy deformation from the synced simulation map.
+				id<MTLTexture> tile = BorrowMaterial(textures.GetSquareTextureID(x, z), "terrain");
+				if (tile == nil) continue;
+				[encoder setFragmentTexture:tile atIndex:0];
+				[encoder setVertexBuffer:drawBuffer offset:draw * DRAW_STRIDE atIndex:2];
+				[encoder drawIndexedPrimitives:MTLPrimitiveTypeTriangle indexCount:TILE_SIZE * TILE_SIZE * 6 indexType:MTLIndexTypeUInt32 indexBuffer:tileIndices indexBufferOffset:0];
+				triangles += TILE_SIZE * TILE_SIZE * 2;
+				++draw;
+			}
+		}
+		Complete(encoder, command, "terrain", terrainLogged, triangles);
+	}
+	void Units() {
+		units.clear();
+		collecting = true;
+		try {
+			// Keep engine traversal, LOS/frustum/icon decisions, Lua materials,
+			// Lua draw overrides, nanoframes and temporary models unchanged.
+			// QueueUnit removes only native-supported default opaque objects.
+			unitDrawer->Draw(false);
+		} catch (...) {
+			collecting = false;
+			throw;
+		}
+		collecting = false;
+		if (units.empty()) return;
+		Frame f = BorrowFrame();
+		size_t pieceCount = 0;
+		for (const CUnit* u : units) pieceCount += u->localModel.pieces.size();
+		ReserveDraws(pieceCount);
+		SetScene(false);
+		id<MTLCommandBuffer> command = [queue commandBuffer];
+		if (command == nil) Fail("cannot create unit command buffer");
+		command.label = @"BAR-METAL units";
+		id<MTLRenderCommandEncoder> encoder = Begin(f, command);
+		[encoder setRenderPipelineState:GetPipelines(f).unit];
+		[encoder setFragmentSamplerState:unitSampler atIndex:0];
+		id<MTLTexture> unitShadow = BorrowShadow();
+		if (unitShadow != nil) {
+			[encoder setFragmentTexture:unitShadow atIndex:3];
+		} else {
+			[encoder setFragmentTexture:whiteShadow atIndex:3];
+		}
+		[encoder setFragmentSamplerState:shadowSampler atIndex:3];
+		uint64_t triangles = 0;
+		size_t draw = 0;
+		for (const CUnit* u : units) {
+			const auto* material = textureHandlerS3O.GetTexture(u->model->textureType);
+			if (material == nullptr) Fail("unit S3O texture material is unavailable");
+			id<MTLTexture> unitTex1 = BorrowMaterial(material->tex1, "units");
+			id<MTLTexture> unitTex2 = BorrowMaterial(material->tex2, "units");
+			if (unitTex1 == nil || unitTex2 == nil) continue;
+			[encoder setFragmentTexture:unitTex1 atIndex:0];
+			[encoder setFragmentTexture:unitTex2 atIndex:1];
+			const CMatrix44f object = u->GetTransformMatrix();
+			const CTeam* team = teamHandler.Team(u->team);
+			for (const LocalModelPiece& piece : u->localModel.pieces) {
+				if (!piece.GetScriptVisible() || !piece.original->HasGeometryData()) continue;
+				const Transform transform = Transform::Lerp(piece.GetEffectivePrevModelSpaceTransform(), piece.GetModelSpaceTransform(), globalRendering->timeOffset);
+				if (transform.s <= 0.0f) continue;
+				Mesh& mesh = GetMesh(piece.original);
+				Draw& d = DrawAt(draw);
+				Matrix(d.world, object * transform.ToMatrix());
+				for (unsigned i = 0; i < 4; ++i) d.team[i] = team->color[i] / 255.0f;
+				[encoder setVertexBuffer:mesh.vertices offset:0 atIndex:0];
+				[encoder setVertexBuffer:drawBuffer offset:draw * DRAW_STRIDE atIndex:2];
+				[encoder setFragmentBuffer:drawBuffer offset:draw * DRAW_STRIDE atIndex:2];
+				[encoder drawIndexedPrimitives:MTLPrimitiveTypeTriangle indexCount:mesh.indexCount indexType:MTLIndexTypeUInt32 indexBuffer:mesh.indices indexBufferOffset:0];
+				triangles += mesh.indexCount / 3;
+				++draw;
+			}
+		}
+		Complete(encoder, command, "units", unitsLogged, triangles);
+	}
+	void Features() {
+		features.clear();
+		collecting = true;
+		try {
+			// Same contract as Units: engine traversal, LOS, Lua materials
+			// and draw masks stay authoritative; only default S3O features
+			// are removed from the compat draw into the native queue.
+			featureDrawer->Draw(false);
+		} catch (...) {
+			collecting = false;
+			throw;
+		}
+		collecting = false;
+		if (features.empty()) return;
+		Frame f = BorrowFrame();
+		size_t pieceCount = 0;
+		for (const CFeature* feat : features) pieceCount += feat->localModel.pieces.size();
+		ReserveDraws(pieceCount);
+		SetScene(false);
+		id<MTLCommandBuffer> command = [queue commandBuffer];
+		if (command == nil) Fail("cannot create feature command buffer");
+		command.label = @"BAR-METAL features";
+		id<MTLRenderCommandEncoder> encoder = Begin(f, command);
+		[encoder setRenderPipelineState:GetPipelines(f).unit];
+		[encoder setFragmentSamplerState:unitSampler atIndex:0];
+		id<MTLTexture> featShadow = BorrowShadow();
+		if (featShadow != nil) {
+			[encoder setFragmentTexture:featShadow atIndex:3];
+		} else {
+			[encoder setFragmentTexture:whiteShadow atIndex:3];
+		}
+		[encoder setFragmentSamplerState:shadowSampler atIndex:3];
+		uint64_t triangles = 0;
+		size_t draw = 0;
+		for (const CFeature* feat : features) {
+			const auto* material = textureHandlerS3O.GetTexture(feat->model->textureType);
+			if (material == nullptr) Fail("feature S3O texture material is unavailable");
+			id<MTLTexture> featTex1 = BorrowMaterial(material->tex1, "features");
+			id<MTLTexture> featTex2 = BorrowMaterial(material->tex2, "features");
+			if (featTex1 == nil || featTex2 == nil) continue;
+			[encoder setFragmentTexture:featTex1 atIndex:0];
+			[encoder setFragmentTexture:featTex2 atIndex:1];
+			const CMatrix44f object = feat->GetTransformMatrix();
+			const CTeam* team = teamHandler.Team(feat->team);
+			for (const LocalModelPiece& piece : feat->localModel.pieces) {
+				if (!piece.GetScriptVisible() || !piece.original->HasGeometryData()) continue;
+				// Static feature geometry never interpolates: unsynced prev
+				// transforms stay zero-scale, so use the current transform.
+				const Transform& transform = piece.GetModelSpaceTransform();
+				if (transform.s <= 0.0f) continue;
+				Mesh& mesh = GetMesh(piece.original);
+				Draw& d = DrawAt(draw);
+				Matrix(d.world, object * transform.ToMatrix());
+				for (unsigned i = 0; i < 4; ++i) d.team[i] = team->color[i] / 255.0f;
+				[encoder setVertexBuffer:mesh.vertices offset:0 atIndex:0];
+				[encoder setVertexBuffer:drawBuffer offset:draw * DRAW_STRIDE atIndex:2];
+				[encoder setFragmentBuffer:drawBuffer offset:draw * DRAW_STRIDE atIndex:2];
+				[encoder drawIndexedPrimitives:MTLPrimitiveTypeTriangle indexCount:mesh.indexCount indexType:MTLIndexTypeUInt32 indexBuffer:mesh.indices indexBufferOffset:0];
+				triangles += mesh.indexCount / 3;
+				++draw;
+			}
+		}
+		Complete(encoder, command, "features", featuresLogged, triangles);
+	}
+	void Projectiles() {
+		projectiles.clear();
+		collecting = true;
+		forwardProjectilePass = true;
+		try {
+			// Only model-type opaque projectiles are collected; billboard
+			// particles, ground flashes and flying pieces stay compat.
+			projectileDrawer->DrawOpaque(false);
+		} catch (...) {
+			collecting = false;
+			forwardProjectilePass = false;
+			throw;
+		}
+		collecting = false;
+		forwardProjectilePass = false;
+		if (projectiles.empty()) return;
+		Frame f = BorrowFrame();
+		ReserveDraws(projectiles.size());
+		SetScene(false);
+		id<MTLCommandBuffer> command = [queue commandBuffer];
+		if (command == nil) Fail("cannot create projectile command buffer");
+		command.label = @"BAR-METAL projectiles";
+		id<MTLRenderCommandEncoder> encoder = Begin(f, command);
+		[encoder setRenderPipelineState:GetPipelines(f).unit];
+		[encoder setFragmentSamplerState:unitSampler atIndex:0];
+		id<MTLTexture> projShadow = BorrowShadow();
+		if (projShadow != nil) {
+			[encoder setFragmentTexture:projShadow atIndex:3];
+		} else {
+			[encoder setFragmentTexture:whiteShadow atIndex:3];
+		}
+		[encoder setFragmentSamplerState:shadowSampler atIndex:3];
+		uint64_t triangles = 0;
+		size_t draw = 0;
+		for (const ProjectileDraw& pd : projectiles) {
+			const S3DModel* model = pd.p->model;
+			const auto* material = textureHandlerS3O.GetTexture(model->textureType);
+			if (material == nullptr) Fail("projectile S3O texture material is unavailable");
+			id<MTLTexture> projTex1 = BorrowMaterial(material->tex1, "projectiles");
+			id<MTLTexture> projTex2 = BorrowMaterial(material->tex2, "projectiles");
+			if (projTex1 == nil || projTex2 == nil) continue;
+			[encoder setFragmentTexture:projTex1 atIndex:0];
+			[encoder setFragmentTexture:projTex2 atIndex:1];
+			const CTeam* team = teamHandler.Team(pd.team);
+			for (int pi = 0, pn = model->numPieces; pi < pn; ++pi) {
+				const S3DModelPiece* piece = model->GetPiece(pi);
+				if (piece == nullptr || !piece->HasGeometryData()) continue;
+				Mesh& mesh = GetMesh(piece);
+				Draw& d = DrawAt(draw);
+				Matrix(d.world, pd.matrix * piece->bposeTransform.ToMatrix());
+				for (unsigned i = 0; i < 4; ++i) d.team[i] = team->color[i] / 255.0f;
+				[encoder setVertexBuffer:mesh.vertices offset:0 atIndex:0];
+				[encoder setVertexBuffer:drawBuffer offset:draw * DRAW_STRIDE atIndex:2];
+				[encoder setFragmentBuffer:drawBuffer offset:draw * DRAW_STRIDE atIndex:2];
+				[encoder drawIndexedPrimitives:MTLPrimitiveTypeTriangle indexCount:mesh.indexCount indexType:MTLIndexTypeUInt32 indexBuffer:mesh.indices indexBufferOffset:0];
+				triangles += mesh.indexCount / 3;
+				++draw;
+			}
+		}
+		Complete(encoder, command, "projectiles", projectilesLogged, triangles);
+	}
+	template<typename TObject>
+	void AlphaObjectsImpl(std::vector<TObject*>& objects, const char* pass, bool& logged, int clip) {
+		// Compat alpha section enables blending with LEQUAL depth and no depth
+		// writes; water clipping arrives as an explicit mode (0 none, 1 below
+		// y<=0, 2 above y>=0) carried in s.shadow.w for this draw only.
+		objects.clear();
+		collecting = true;
+		try {
+			if constexpr (std::is_same_v<TObject, CUnit>) unitDrawer->DrawAlphaPass(false);
+			else featureDrawer->DrawAlphaPass(false);
+		} catch (...) {
+			collecting = false;
+			throw;
+		}
+		collecting = false;
+		if (objects.empty()) return;
+		Frame f = BorrowFrame();
+		size_t pieceCount = 0;
+		for (const auto* o : objects) pieceCount += o->localModel.pieces.size();
+		ReserveDraws(pieceCount);
+		SetScene(false);
+		Scene& as = *static_cast<Scene*>(sceneBuffer.contents);
+		as.shadow[3] = float(clip);
+		id<MTLCommandBuffer> command = [this->queue commandBuffer];
+		if (command == nil) Fail("cannot create alpha command buffer");
+		command.label = [NSString stringWithUTF8String:pass];
+		id<MTLRenderCommandEncoder> encoder = Begin(f, command);
+		[encoder setRenderPipelineState:GetPipelines(f).unitAlpha];
+		[encoder setDepthStencilState:alphaDepthState];
+		[encoder setFragmentSamplerState:unitSampler atIndex:0];
+		id<MTLTexture> alphaShadow = BorrowShadow();
+		if (alphaShadow != nil) {
+			[encoder setFragmentTexture:alphaShadow atIndex:3];
+		} else {
+			[encoder setFragmentTexture:whiteShadow atIndex:3];
+		}
+		[encoder setFragmentSamplerState:shadowSampler atIndex:3];
+		uint64_t triangles = 0;
+		size_t draw = 0;
+		for (const auto* o : objects) {
+			const auto* material = textureHandlerS3O.GetTexture(o->model->textureType);
+			if (material == nullptr) Fail("alpha S3O texture material is unavailable");
+			id<MTLTexture> tex1 = BorrowMaterial(material->tex1, pass);
+			id<MTLTexture> tex2 = BorrowMaterial(material->tex2, pass);
+			if (tex1 == nil || tex2 == nil) continue;
+			[encoder setFragmentTexture:tex1 atIndex:0];
+			[encoder setFragmentTexture:tex2 atIndex:1];
+			const CMatrix44f object = o->GetTransformMatrix();
+			const CTeam* team = teamHandler.Team(o->team);
+			for (const LocalModelPiece& piece : o->localModel.pieces) {
+				if (!piece.GetScriptVisible() || !piece.original->HasGeometryData()) continue;
+				const Transform transform = Transform::Lerp(piece.GetEffectivePrevModelSpaceTransform(), piece.GetModelSpaceTransform(), globalRendering->timeOffset);
+				if (transform.s <= 0.0f) continue;
+				Mesh& mesh = GetMesh(piece.original);
+				Draw& d = DrawAt(draw);
+				Matrix(d.world, object * transform.ToMatrix());
+				for (unsigned i = 0; i < 4; ++i) d.team[i] = team->color[i] / 255.0f;
+				d.team[3] = IModelDrawerState::alphaValues.x;
+				[encoder setVertexBuffer:mesh.vertices offset:0 atIndex:0];
+				[encoder setVertexBuffer:drawBuffer offset:draw * DRAW_STRIDE atIndex:2];
+				[encoder setFragmentBuffer:drawBuffer offset:draw * DRAW_STRIDE atIndex:2];
+				[encoder drawIndexedPrimitives:MTLPrimitiveTypeTriangle indexCount:mesh.indexCount indexType:MTLIndexTypeUInt32 indexBuffer:mesh.indices indexBufferOffset:0];
+				triangles += mesh.indexCount / 3;
+				++draw;
+			}
+		}
+		Complete(encoder, command, pass, logged, triangles);
+	}
+	void AlphaObjects(bool units, int clip) {
+		if (units) AlphaObjectsImpl(alphaUnits, "alphaUnits", alphaUnitsLogged, clip);
+		else AlphaObjectsImpl(alphaFeatures, "alphaFeatures", alphaFeaturesLogged, clip);
+	}
+	void BuildWaterGeometry(bool endless) {
+		// Mirrors CBumpWater::GenWaterPlaneBuffer vertex positions as indexed
+		// triangles (compat uses arrays/strips; indices are equivalent).
+		struct WPos { float v[3]; };
+		std::vector<WPos> verts;
+		std::vector<uint32_t> idx;
+		if (endless) {
+			const float xsize = float((mapDims.mapx * SQUARE_SIZE) >> 2);
+			const float ysize = float((mapDims.mapy * SQUARE_SIZE) >> 2);
+			const float step = 6.283185307179586f / 32.0f;
+			const float size = std::min(xsize, ysize);
+			for (int n = 0; n < 4; ++n) {
+				const float k = (n == 3) ? 0.5f : 1.0f;
+				const float r1 = float(n * n) * size;
+				const float r2 = float((n + k) * (n + k)) * size;
+				uint32_t base = verts.size();
+				for (int s = 0; s <= 32; ++s) {
+					const float a = s * step;
+					const float sn = sinf(a), cs = cosf(a);
+					verts.push_back({{r1 * sn + 2 * xsize, 0.0f, r1 * cs + 2 * ysize}});
+					verts.push_back({{r2 * sn + 2 * xsize, 0.0f, r2 * cs + 2 * ysize}});
+				}
+				for (int s = 0; s < 32; ++s) {
+					uint32_t a = base + s * 2, b = a + 1, c = a + 2, d = a + 3;
+					idx.insert(idx.end(), {a, b, c, b, d, c});
+				}
+			}
+		waterPrimitive = MTLPrimitiveTypeTriangle;
+		} else {
+			const float mapX = float(mapDims.mapx * SQUARE_SIZE);
+			const float mapZ = float(mapDims.mapy * SQUARE_SIZE);
+			for (int z = 0; z <= 9; ++z) {
+				for (int x = 0; x <= 9; ++x) {
+					verts.push_back({{x * (mapX / 9.0f), 0.0f, z * (mapZ / 9.0f)}});
+				}
+			}
+			for (int z = 0; z < 9; ++z) {
+				for (int x = 0; x < 9; ++x) {
+					uint32_t v0 = z * 10 + x, v1 = v0 + 10, v2 = v0 + 1, v3 = v1 + 1;
+					idx.insert(idx.end(), {v0, v1, v2, v1, v3, v2});
+				}
+			}
+		waterPrimitive = MTLPrimitiveTypeTriangle;
+		}
+		waterBuffer = [device newBufferWithBytes:verts.data() length:verts.size() * sizeof(WPos) options:MTLResourceStorageModeShared];
+		id<MTLBuffer> waterIdx = [device newBufferWithBytes:idx.data() length:idx.size() * sizeof(uint32_t) options:MTLResourceStorageModeShared];
+		if (waterBuffer == nil || waterIdx == nil) Fail("cannot allocate water geometry");
+		waterIndexBuffer = waterIdx;
+		waterIndexCount = idx.size();
+	}
+	id<MTLRenderPipelineState> GetWaterPipeline(const Frame& f, CBumpWater& water) {
+		unsigned key = (water.HasReflection() ? 1 : 0) | (water.HasRefraction() ? 2 : 0)
+		    | (water.HasShoreWaves() ? 4 : 0) | (water.HasDepthCopy() ? 8 : 0)
+		    | (water.HasBlurReflection() ? 16 : 0) | (water.IsEndlessOcean() ? 32 : 0)
+		    | (shadowHandler.ShadowsLoaded() ? 64 : 0)
+		    | (infoTextureHandler->IsEnabled() ? 128 : 0);
+		uint64_t full = (uint64_t(key) << 32) | (uint64_t(f.color.pixelFormat) << 16) | uint64_t(f.depth.pixelFormat);
+		auto it = waterPipelines.find(full);
+		if (it != waterPipelines.end()) return it->second;
+		std::string defines;
+		if (key & 1) defines += "#define OPT_REFLECTION\n";
+		if (key & 2) defines += "#define OPT_REFRACTION\n";
+		if (key & 4) defines += "#define OPT_SHORE\n";
+		if (key & 8) defines += "#define OPT_DEPTH\n";
+		if (key & 16) defines += "#define OPT_BLURREFL\n";
+		if (key & 32) defines += "#define OPT_ENDLESS\n";
+		if (key & 64) defines += "#define OPT_SHADOWS\n";
+		if (key & 128) defines += "#define OPT_INFOTEX\n";
+		NSString* defs = [NSString stringWithUTF8String:defines.c_str()];
+		NSString* base = [NSString stringWithUTF8String:metalSource];
+		NSString* source = [defs stringByAppendingString:base];
+		NSError* error = nil;
+		id<MTLLibrary> waterLib = [device newLibraryWithSource:source options:nil error:&error];
+		if (waterLib == nil) Fail("cannot create water MSL library: " + ErrorText(error));
+		MTLRenderPipelineDescriptor* desc = [MTLRenderPipelineDescriptor new];
+		desc.colorAttachments[0].pixelFormat = f.color.pixelFormat;
+		desc.depthAttachmentPixelFormat = f.depth.pixelFormat;
+		desc.colorAttachments[0].blendingEnabled = water.HasRefraction() ? NO : YES;
+		desc.colorAttachments[0].sourceRGBBlendFactor = MTLBlendFactorSourceAlpha;
+		desc.colorAttachments[0].destinationRGBBlendFactor = MTLBlendFactorOneMinusSourceAlpha;
+		desc.colorAttachments[0].sourceAlphaBlendFactor = MTLBlendFactorOne;
+		desc.colorAttachments[0].destinationAlphaBlendFactor = MTLBlendFactorOneMinusSourceAlpha;
+		desc.vertexFunction = [waterLib newFunctionWithName:@"waterVert"];
+		desc.fragmentFunction = [waterLib newFunctionWithName:@"waterFragment"];
+		id<MTLRenderPipelineState> pipeline = [device newRenderPipelineStateWithDescriptor:desc error:&error];
+		if (pipeline == nil) Fail("cannot create water Metal pipeline: " + ErrorText(error));
+		waterPipelines.emplace(full, pipeline);
+		return pipeline;
+	}
+	void Water() {
