diff --git a/src/gallium/targets/dri/recoil_metal.c b/src/gallium/targets/dri/recoil_metal.c
new file mode 100644
index 0000000..0493ad5
--- /dev/null
+++ b/src/gallium/targets/dri/recoil_metal.c
@@ -0,0 +1,139 @@
+/* SPDX-License-Identifier: MIT */
+#include "main/context.h"
+#include "main/framebuffer.h"
+#include "main/renderbuffer.h"
+#include "main/state.h"
+#include "main/texobj.h"
+#include "state_tracker/st_manager.h"
+#include "pipe/p_context.h"
+#include "pipe/p_state.h"
+#include "util/format/u_format.h"
+#include "zink/zink_recoil_metal.h"
+
+/* The bridge deliberately performs no GPU waits. glFinish before borrowing and
+ * Metal command-buffer completion before resuming GL serialize the two queues.
+ * This sacrifices overlap for correctness without any framebuffer copy.
+ */
+static struct gl_context *
+recoil_metal_context(void)
+{
+   struct gl_context *ctx = _mesa_get_current_context();
+   if (!ctx || !ctx->st || !ctx->pipe || !ctx->screen ||
+       _mesa_inside_begin_end(ctx) ||
+       (ctx->Dispatch.ContextLost &&
+        ctx->Dispatch.Current == ctx->Dispatch.ContextLost))
+      return NULL;
+   return ctx;
+}
+
+static bool
+recoil_metal_renderbuffer(struct gl_context *ctx, struct gl_renderbuffer *rb,
+                          bool depth)
+{
+   if (!rb || !rb->texture || rb->software || rb->NumSamples > 1 ||
+       rb->NumStorageSamples > 1 || rb->rtt_layered || rb->rtt_numviews > 1)
+      return false;
+
+   if (rb->is_rtt)
+      _mesa_update_renderbuffer_surface(ctx, rb);
+
+   struct pipe_surface *surface = &rb->surface;
+   struct pipe_resource *resource = rb->texture;
+   if (surface->texture != resource || surface->level != 0 ||
+       surface->first_layer != 0 || surface->last_layer != 0 ||
+       surface->nr_samples > 1 || rb->Width != resource->width0 ||
+       rb->Height != resource->height0 || !rb->Width || !rb->Height)
+      return false;
+
+   /* Returning the base image cannot express a reinterpreted attachment view,
+    * including an sRGB/linear view selected by GL_FRAMEBUFFER_SRGB.
+    */
+   enum pipe_format format = depth ? surface->format :
+      _mesa_renderbuffer_get_format(ctx, rb);
+   if (format != resource->format)
+      return false;
+
+   return depth ? util_format_has_depth(util_format_description(format)) :
+      !util_format_is_depth_or_stencil(format);
+}
+
+__attribute__((visibility("default"))) int
+recoil_metal_frame(void **color, void **depth)
+{
+   if (color)
+      *color = NULL;
+   if (depth)
+      *depth = NULL;
+   if (!color || !depth || color == depth)
+      return 0;
+
+   struct gl_context *ctx = recoil_metal_context();
+   if (!ctx || !ctx->DrawBuffer || !ctx->ReadBuffer)
+      return 0;
+
+   /* Drawable resources can change after a swap or resize. Validate the live
+    * framebuffer every query; never cache borrowed native attachments.
+    */
+   st_manager_validate_framebuffers(ctx->st);
+   if (ctx->NewState)
+      _mesa_update_state(ctx);
+   _mesa_update_framebuffer(ctx, ctx->ReadBuffer, ctx->DrawBuffer);
+
+   struct gl_framebuffer *fb = ctx->DrawBuffer;
+   if (fb->_Status != GL_FRAMEBUFFER_COMPLETE ||
+       _mesa_fb_orientation(fb) != Y_0_TOP || fb->_NumColorDrawBuffers != 1 ||
+       fb->resolve || fb->Width == 0 || fb->Height == 0)
+      return 0;
+
+   struct gl_renderbuffer *color_rb = fb->_ColorDrawBuffers[0];
+   struct gl_renderbuffer *depth_rb = fb->Attachment[BUFFER_DEPTH].Renderbuffer;
+   if (!recoil_metal_renderbuffer(ctx, color_rb, false) ||
+       !recoil_metal_renderbuffer(ctx, depth_rb, true) ||
+       color_rb->Width != depth_rb->Width ||
+       color_rb->Height != depth_rb->Height ||
+       color_rb->Width != fb->Width || color_rb->Height != fb->Height)
+      return 0;
+
+   void *native_color = zink_recoil_metal_texture(ctx->screen, color_rb->texture);
+   void *native_depth = zink_recoil_metal_texture(ctx->screen, depth_rb->texture);
+   if (!native_color || !native_depth)
+   return 0;
+
+   *color = native_color;
+   *depth = native_depth;
+   return 1;
+}
+
+__attribute__((visibility("default"))) void *
+recoil_metal_texture(unsigned int name)
+{
+   struct gl_context *ctx = recoil_metal_context();
+   if (!ctx || !name)
+      return NULL;
+
+   struct gl_texture_object *texture = _mesa_lookup_texture(ctx, name);
+   if (!texture || texture->Target != GL_TEXTURE_2D || !texture->pt ||
+       texture->Attrib.BaseLevel != 0 || texture->Attrib.MinLevel != 0 ||
+       texture->Attrib.MinLayer != 0 ||
+       (texture->surface_based && texture->surface_format != texture->pt->format)) {
+      return NULL;
+   }
+
+   struct gl_texture_image *base = texture->Image[0][0];
+   if (!base || base->pt != texture->pt ||
+       base->Width != texture->pt->width0 ||
+       base->Height != texture->pt->height0 ||
+       texture->pt->last_level >= MAX_TEXTURE_LEVELS) {
+      return NULL;
+   }
+   for (unsigned level = 0; level <= texture->pt->last_level; level++) {
+      struct gl_texture_image *image = texture->Image[0][level];
+      if (image && image->pt != texture->pt)
+         return NULL;
+   }
+
+   /* Do not finalize a texture here: that can migrate/copy its storage after
+    * the caller's glFinish. An unallocated or stale backing is rejected.
+    */
+   return zink_recoil_metal_texture(ctx->screen, texture->pt);
+}
