+__attribute__((visibility("default"))) void *
+recoil_metal_vk_image(uint64_t image_handle)
+{
+   if (!image_handle)
+      return NULL;
+
+   struct kk_image *image =
+      kk_image_from_handle((VkImage)(uintptr_t)image_handle);
+   if (image->vk.base.type != VK_OBJECT_TYPE_IMAGE ||
+       image->vk.image_type != VK_IMAGE_TYPE_2D ||
+       image->vk.array_layers != 1 || image->vk.samples != VK_SAMPLE_COUNT_1_BIT ||
+       image->plane_count != 1 || image->disjoint ||
+       !image->planes[0].mtl_handle)
+      return NULL;
+
+   /* This is the live image backing, not an image view, copy, or readback.
+    * Borrow only until the caller's Metal commands complete; do not retain it.
+    */
+   return image->planes[0].mtl_handle;
+}
