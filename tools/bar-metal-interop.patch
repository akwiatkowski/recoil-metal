+/* SPDX-License-Identifier: MIT */
+#ifndef ZINK_RECOIL_METAL_H
+#define ZINK_RECOIL_METAL_H
+
+struct pipe_screen;
+struct pipe_resource;
+
+/* Borrowed native textures: caller must finish GL first and finish Metal before
+ * resuming GL. No texture lifetime extends beyond that synchronized interval.
+ */
+void *zink_recoil_metal_texture(struct pipe_screen *screen,
+                                struct pipe_resource *resource);
+int recoil_metal_frame(void **color, void **depth);
+void *recoil_metal_texture(unsigned int name);
+
+#endif
