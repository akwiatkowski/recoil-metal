+void *
+zink_recoil_metal_texture(struct pipe_screen *pscreen,
+                         struct pipe_resource *resource)
+{
+   if (!pscreen || !resource)
+      return NULL;
+
+   if (pscreen->get_driver_pipe_screen)
+      pscreen = pscreen->get_driver_pipe_screen(pscreen);
+   if (!pscreen || !pscreen->get_name)
+      return NULL;
+
+   const char *name = pscreen->get_name(pscreen);
+   if (!name || strncmp(name, "zink Vulkan ", 12) != 0)
+      return NULL;
+
+   struct pipe_screen *resource_screen = resource->screen;
+   if (resource_screen && resource_screen->get_driver_pipe_screen)
+      resource_screen = resource_screen->get_driver_pipe_screen(resource_screen);
+   if (resource_screen != pscreen ||
+       resource->target != PIPE_TEXTURE_2D ||
+       resource->array_size != 1 || resource->depth0 != 1 ||
+       resource->nr_samples > 1 || resource->nr_storage_samples > 1 ||
+       (resource->flags & PIPE_RESOURCE_FLAG_SPARSE))
+      return NULL;
+
+   struct zink_screen *screen = zink_screen(pscreen);
+   if (zink_driverid(screen) != VK_DRIVER_ID_MESA_KOSMICKRISP ||
+       screen->device_lost || !screen->loader_lib)
+      return NULL;
+
+   struct zink_resource *res = zink_resource(resource);
+   if (!res->obj || !res->obj->image || res->deleted ||
+       res->transient || res->unflushed_transient)
+      return NULL;
+
+   typedef void *(*export_image_fn)(uint64_t);
+   export_image_fn export_image = NULL;
+   /* The Vulkan loader opened the ICD by its absolute install path, which
+    * this bridge cannot know. RTLD_NOLOAD matches by path string, so locate
+    * the already-loaded Kosmickrisp image through dyld and re-open that exact
+    * path (no new copy, no other driver). Nothing is copied or retained.
+    */
+   uint32_t image_count = _dyld_image_count();
+   for (uint32_t i = 0; i < image_count && !export_image; i++) {
+      const char *name = _dyld_get_image_name(i);
+      if (name && strstr(name, "libvulkan_kosmickrisp") != NULL) {
+         void *driver = dlopen(name, RTLD_NOW | RTLD_NOLOAD | RTLD_LOCAL);
+         if (driver)
+            export_image = (export_image_fn)dlsym(driver, "recoil_metal_vk_image");
+      }
+   }
+   if (!export_image)
+      return NULL;
+
+   return export_image((uint64_t)(uintptr_t)res->obj->image);
+}
+
 
 
