diff --git a/rts/lib/headlessStubs/CMakeLists.txt b/rts/lib/headlessStubs/CMakeLists.txt
index 43c24d3..e01eccf 100644
--- a/rts/lib/headlessStubs/CMakeLists.txt
+++ b/rts/lib/headlessStubs/CMakeLists.txt
@@ -1,10 +1,40 @@
 SET(headlessStubsSources
 		"gladstub.cpp"
-		"sdlstub.c"
 	)
 
 find_package(SDL2 MODULE REQUIRED)
 
+# sdlstub.c hand-implements the SDL2 ABI so that headless builds need no SDL
+# library at all. That approach does not survive SDL3: the stub is written against
+# DECLSPEC, SDL_INIT_EVERYTHING, SDL_RWops, SDL_version and the 6-argument
+# SDL_CreateWindow, none of which exist in SDL3. Porting it would mean maintaining
+# ~80 hand-written stubs against a moving API.
+#
+# On the SDL3 path we link the real SDL3 instead and let its "dummy" video driver
+# provide the headless behaviour (SDL_VIDEODRIVER=dummy). GL is still stubbed by
+# gladstub.cpp, which is the part headless actually needs.
+if (APPLE AND RECOIL_MACOS_SDL3_EGL)
+	set(HEADLESS_USES_REAL_SDL TRUE)
+else()
+	set(HEADLESS_USES_REAL_SDL FALSE)
+	list(APPEND headlessStubsSources "sdlstub.c")
+endif()
+
+# gladstub.cpp reaches streflop_cond.h transitively, which on ARM64 needs
+# STREFLOP_NEON to avoid resolving math::sqrtf to the SSE implementation.
+# This target is built outside the headless folder, so it does not pick up the
+# definitions added in rts/builds/headless/CMakeLists.txt.
+if (ENABLE_STREFLOP AND STREFLOP_NEON)
+	add_definitions(-DSTREFLOP_NEON)
+endif ()
+
 ADD_LIBRARY(headlessStubs STATIC EXCLUDE_FROM_ALL ${headlessStubsSources})
-target_link_libraries(headlessStubs PUBLIC $<COMPILE_ONLY:SDL2::SDL2>)
+
+if (HEADLESS_USES_REAL_SDL)
+	# Link, not just compile against: the stub used to supply these symbols.
+	target_link_libraries(headlessStubs PUBLIC SDL2::SDL2)
+else()
+	target_link_libraries(headlessStubs PUBLIC $<COMPILE_ONLY:SDL2::SDL2>)
+endif()
+
 SET_TARGET_PROPERTIES(headlessStubs PROPERTIES COMPILE_FLAGS "${PIC_FLAG}")
