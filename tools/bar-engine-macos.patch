diff --git a/AI/CMakeLists.txt b/AI/CMakeLists.txt
index 9ec1c9a..c37d018 100644
--- a/AI/CMakeLists.txt
+++ b/AI/CMakeLists.txt
@@ -11,6 +11,15 @@
 
 add_definitions(-DBUILDING_AI)
 
+# AI wrappers include engine headers that reach streflop_cond.h (AIFloat3.cpp ->
+# System/float3.h). Without STREFLOP_NEON on ARM64 they take the non-streflop
+# branch, which resolves math::sqrtf to fastmath's SSE implementation and fails
+# to compile. Scoped to this directory rather than set globally, because a global
+# definition also reaches vendored third-party code that is not streflop-aware.
+if (ENABLE_STREFLOP AND STREFLOP_NEON)
+	add_definitions(-DSTREFLOP_NEON)
+endif ()
+
 
 ### User-definable build options
 set (AI_EXCLUDE_REGEX "XXXXXXXX" CACHE STRING "Which Skirmish AIs not to build (none by default, example: \"NTai|Null.*AI\", see also: AI_TYPES")
diff --git a/CMakeLists.txt b/CMakeLists.txt
index d35d402..ac113fe 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -319,6 +319,26 @@ endif (RECOIL_DETAILED_TRACY_ZONING)
 find_package(SDL2 MODULE)
 if (APPLE AND RECOIL_MACOS_SDL3_EGL)
 	find_package(MesaEGL MODULE)
+
+	# The SDLCompat shims must outrank the real SDL2 headers, which on Homebrew
+	# live under /opt/homebrew/include/SDL2 -- a prefix already added to the
+	# include path for DevIL, minizip and friends. Directory-level entries are
+	# searched before a target's INTERFACE includes, so the BEFORE INTERFACE in
+	# FindSDL2.cmake is not sufficient on its own.
+	#
+	# If real SDL2 wins, sources including <SDL2/SDL_keyboard.h> pull in SDL2's
+	# headers, which define the SAME include guards as SDL3 (SDL_stdinc_h_,
+	# SDL_pixels_h_, ...). SDL3's versions are then silently skipped and the
+	# build fails with "unknown type name 'SDL_FunctionPointer'" and
+	# "unknown type name 'SDL_FColor'" from deep inside SDL3's own headers.
+	include_directories(BEFORE "${CMAKE_SOURCE_DIR}/rts/System/SDLCompat")
+
+	# Same hazard, different library: Homebrew ships fmt 12.2.0 while the tree
+	# vendors 12.1.0. Both use the fmt::v12 inline namespace, so the mismatch is
+	# invisible until link time, when 12.2.0's headers reference
+	# fmt::v12::detail::allocate() that 12.1.0's libfmt.a does not define.
+	# The vendored headers have to win over /opt/homebrew/include.
+	include_directories(BEFORE "${CMAKE_SOURCE_DIR}/rts/lib/fmt/include")
 endif()
 
 find_package_static(DevIL 1.8.0 REQUIRED)
@@ -449,6 +469,11 @@ if (ENABLE_STREFLOP)
 	set(STREFLOP_AUTO ON CACHE BOOL "Enable STREFLOP autodetection" FORCE)
 	if (IS_ARM64_BUILD)
 		set(STREFLOP_NEON ON CACHE BOOL "Use ARM NEON for deterministic ARM64 streflop" FORCE)
+		# NOTE: do NOT add_definitions(-DSTREFLOP_NEON) globally here. It would
+		# reach vendored third-party code (assimp in particular), which is not
+		# built against streflop and fails with "no member named 'abs' in
+		# namespace 'std'". The definition is added per-directory instead, in
+		# the directories holding code that reaches streflop_cond.h.
 	endif ()
 else ()
 	add_definitions(-DNOT_USING_STREFLOP)
