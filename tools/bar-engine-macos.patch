     return 0;
-}
\ No newline at end of file
+}
+// The macOS SDL3/EGL bridge (rts/System/Platform/Mac/MacSDL3EGLBridge.mm) calls
+// gladLoadGLLoader() to resolve GL entry points through eglGetProcAddress. That
+// bridge is compiled into the headless build too, because it lives in the shared
+// Mac platform source list, so the symbol has to exist here.
+//
+// Headless never renders: every GL entry point is already replaced by a stub in
+// gladLoadGL(), so the loader argument is ignored and we simply delegate.
+extern "C" int gladLoadGLLoader(void* (*)(const char*)) {
+    return gladLoadGL();
+}
